.idea
node_modules
coverage/
.coverage/
lib/
.vsconfig
yarn-error.log
.orig
*.log
logs/*
!**/.gitkeep
# Captured real Unity licensing logs, used as grading fixtures by
# scripts/test-licensing-verdict.sh. They are logs, hence the re-include: what
# makes them worth committing is that they are what real editors actually
# emitted, which is the one thing a stub cannot provide.
!scripts/fixtures/licensing/*.log
.env*
!.env*.dist
*.exe

# The compiled CLI binary. *.exe above covers Windows, but the Linux/macOS
# build has no extension - without this, `bun run build:binary` leaves an
# untracked ~120MB binary that dirties the tree, and the CLI then refuses to
# version a build from it ("Branch is dirty. Refusing to base semantic version
# on uncommitted changes").
/game-ci
