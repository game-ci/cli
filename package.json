{
  "name": "@game-ci/cli",
  "version": "0.1.25",
  "description": "GameCI CLI - automation for game engines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/game-ci/cli.git"
  },
  "bin": {
    "game-ci": "src/index.ts"
  },
  "workspaces": [
    "plugins/*"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:binary": "bun build src/index.ts --compile --outfile game-ci",
    "test": "bun test ./src",
    "lint": "echo 'Not implemented yet.'"
  },
  "dependencies": {
    "@game-ci/orchestrator": "workspace:*",
    "@game-ci/runtime-test-framework": "workspace:*",
    "@game-ci/steam-deploy": "workspace:*",
    "dotenv": "^16.3.1",
    "semver": "^7.5.4",
    "unity-changeset": "^3.4.0",
    "yaml": "^2.3.4",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/semver": "^7.5.6",
    "@types/yargs": "^17.0.32",
    "bun-types": "latest",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
