{
  "name": "@game-ci/unity-engine-core",
  "version": "0.1.0",
  "description": "Unity build/test/activation implementation logic, invoked by game-ci/cli and the thin-wrapper action repos (unity-builder, unity-test-runner, unity-activate).",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": "git@github.com:game-ci/unity-engine-core.git",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/copy-static-assets.mjs",
    "prepare": "tsc && node scripts/copy-static-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6",
    "handlebars": "^4.7.7",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@octokit/openapi-types": "^11.2.0",
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^2"
  }
}
